<Window x:Class="Noteblack.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="About Noteblack" Height="420" Width="480"
        Icon="app_icon.png"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#121212" Foreground="#ECECEC">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="#121212">
            <TextBlock Text="About Noteblack" Foreground="#D4D4D4" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"/>
            <Button Content="✕" Width="40" Height="32" HorizontalAlignment="Right" Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" Click="BtnClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="24,12,24,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <!-- App Icon -->
                <Image Source="app_icon.png" Width="48" Height="48" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Noteblack" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Version 1.0.0 • Pure Black Edition" FontSize="12" Foreground="#8B949E" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="A modern Windows Notepad clone crafted in pure black with full universal newline character support."
                       Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="20"/>

            <Border Background="#181818" CornerRadius="6" BorderBrush="#282828" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Supported Newline Characters:" FontWeight="SemiBold" Foreground="#58A6FF" Margin="0,0,0,8" FontSize="12.5"/>
                    <TextBlock Text="• Windows: CRLF (\r\n) — Standard Windows line breaks" Foreground="#DDDDDD" Margin="0,2,0,2" FontSize="11.5"/>
                    <TextBlock Text="• Unix / Linux / macOS: LF (\n) — Standard POSIX line breaks" Foreground="#DDDDDD" Margin="0,2,0,2" FontSize="11.5"/>
                    <TextBlock Text="• Macintosh: CR (\r) — Classic Apple Mac OS line breaks" Foreground="#DDDDDD" Margin="0,2,0,2" FontSize="11.5"/>
                    <TextBlock Text="• Unicode: NEL (\u0085), LS (\u2028), PS (\u2029)" Foreground="#AAAAAA" Margin="0,2,0,2" FontSize="11.5"/>
                    <TextBlock Text="Automatic detection on open, status bar switcher, and seamless conversion." Foreground="#8B949E" FontStyle="Italic" Margin="0,6,0,0" FontSize="11"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Dark Features: Deep black title bar, dark menus, dark scrollbars, caret, find/replace, and customizable black themes."
                       Foreground="#888888" TextWrapping="Wrap" FontSize="11.5"/>
        </StackPanel>

        <!-- Bottom OK Button -->
        <Border Grid.Row="2" Background="#161616" BorderBrush="#222222" BorderThickness="0,1,0,0" Padding="0,10,20,10">
            <Button Content="OK" Width="84" Height="28" HorizontalAlignment="Right" Background="#0E639C" Foreground="#FFFFFF" BorderThickness="0" Click="BtnClose_Click"/>
        </Border>
    </Grid>
</Window>
